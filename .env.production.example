# Production names only. This file is not a bootable deployment and is not used by CI.
# Inject real values from a secret manager. Never commit them.
# STORAGE_PROVIDER stays undecided until an approved object store exists.
# PAYMENT_PROVIDER stays fake until written provider and legal approval exist.
TAALIM_ENV=production
DATABASE_URL=postgresql://taalim:CHANGE_ME@production-db.internal:5432/taalim_production
STORAGE_PROVIDER=undecided
STORAGE_LOCAL_ROOT=.data/production-must-not-use-local-learner-files
STORAGE_ACCESS_SECRET=replace-with-a-production-secret-manager-value
PAYMENT_PROVIDER=fake
LOG_LEVEL=info
APP_BASE_URL=https://app.example.invalid
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_production_clerk_key
CLERK_SECRET_KEY=sk_live_replace_with_production_clerk_secret
